#!/bin/bash
CALLS_FILE=/tmp/zmypy_annotation_calls.txt
if [ "$1" = "-V" ]; then
  echo "zuban 0.9.0"
else
  for last; do :; done
  # the target must live inside the CWD (the mirror root) — like a real mirror run
  case "$last" in
    "$PWD"/*) : ;;
    *) >&2 echo "target $last is outside the CWD $PWD"; exit 2 ;;
  esac
  expected_args="--show-column-numbers $last"
  if [ "$*" != "$expected_args" ]; then
    >&2 echo "expected: $expected_args"
    >&2 echo "received: $*"
    exit 2
  fi
  # report the marker line of the checked file, so the test can verify which
  # content (on-disk vs in-memory) and which position were actually checked
  marker=$(grep -n 'E_MARKER' "$last" | head -1 | cut -d: -f1)
  lines=$(awk 'END { print NR }' "$last")
  if [ -L "$last" ]; then kind=SYMLINK; else kind=REGULAR; fi
  printf '%s|%s|%s|%s|%s\n' "$PWD" "$*" "${marker:-0}" "$lines" "$kind" >> "$CALLS_FILE"
  rel=$(realpath -m --relative-to="$PWD" "$last")
  if [ -n "$marker" ]; then
    echo "$rel:$marker:1: error: A test error  [test-code]"
    echo "Found 1 error in 1 file (checked 1 source file)"
    exit 1
  else
    echo "Success: no issues found in 1 source file"
    exit 0
  fi
fi
